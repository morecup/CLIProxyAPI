      ],
      "order": 260,
      "position": "headless print flow: gC(i,Sg,{waitForDeferrable:!0,...}) runs synchronously to its emit when no client is pending (no await is reached), after installPluginsForHeadless and the shell allow-rule init, before the tengu_sdk_init_handshake emit (function bodies at chunk offsets 318500 vs 324439)",
      "condition": "unconditional in headless (-p / stream-json) mode: skipTelemetry is false at the first call site (captured in 99/99 sessions; datadog-logs mirror 101 occurrences)",
      "keys": [
        "localOnly",
        "willDeferMcp",
        "waitForDeferrable",
        "deadlineMs",
        "pendingBefore",
        "pendingWaitedBefore",
        "toolsBefore",
        "waitedMs",
        "permissionPromptServerPendingBefore",
        "permissionPromptWaitedMs",
        "pendingAfter",
        "pendingWaitedAfter",
        "permissionPromptServerPendingAfter",
        "toolsAfter",
        "mcpNonBlocking"
      ],
      "metadata": {
        "localOnly": false,
        "willDeferMcp": false,
        "waitForDeferrable": true,
        "deadlineMs": 2000,
        "pendingBefore": 0,
        "pendingWaitedBefore": 0,
        "toolsBefore": 0,
        "waitedMs": 0,
        "permissionPromptServerPendingBefore": false,
        "permissionPromptWaitedMs": 0,
        "pendingAfter": 0,
        "pendingWaitedAfter": 0,
        "permissionPromptServerPendingAfter": false,
        "toolsAfter": 0,
        "mcpNonBlocking": true
      },
      "metadata_json": "{\"localOnly\":false,\"willDeferMcp\":false,\"waitForDeferrable\":true,\"deadlineMs\":2000,\"pendingBefore\":0,\"pendingWaitedBefore\":0,\"toolsBefore\":0,\"waitedMs\":0,\"permissionPromptServerPendingBefore\":false,\"permissionPromptWaitedMs\":0,\"pendingAfter\":0,\"pendingWaitedAfter\":0,\"permissionPromptServerPendingAfter\":false,\"toolsAfter\":0,\"mcpNonBlocking\":true}",
      "derivations": {
        "localOnly": "tN(d).localOnly = Boolean(d.sdkUrl)&&CLAUDE_CODE_ENVIRONMENT_KIND!==\"bridge\" && !coordinator; the Desktop spawn argv never passes --sdk-url (no sdkUrl in the three main-process chunks) => false",
        "willDeferMcp": "p=!a&&ZM()&&JM(Mt())&&!XM(Aw(Mt())); a=waitForDeferrable is !0 at both call sites => false without evaluating the tool-search gates",
        "waitForDeferrable": "call-site option waitForDeferrable:!0 => true",
        "deadlineMs": "gC parameter t (default 2000); tN(d).deadlineMs is qf() only when d.explicitMcpConfigFlag (Desktop pushes --mcp-config only when Object.keys(mcpServers).length>0); zero configured servers (handshake mcp_client_count 0) => undefined => 2000",
        "pendingBefore": "Bs(d.clients, type===\"pending\") over zero clients => 0",
        "pendingWaitedBefore": "Bs(d.clients, C) => 0",
        "toolsBefore": "d.tools.length => 0",
        "waitedMs": "G stays 0 when pendingWaitedBefore===0 (no wait loop)",
        "permissionPromptServerPendingBefore": "d.clients.some(b) => false",
        "permissionPromptWaitedMs": "z stays 0 when no permission-prompt server is pending",
        "pendingAfter": "Bs(_.clients, type===\"pending\") => 0",
        "pendingWaitedAfter": "Bs(_.clients, C) => 0",
        "permissionPromptServerPendingAfter": "_.clients.some(b) => false",
        "toolsAfter": "_.tools.length => 0",
        "mcpNonBlocking": "wa() = host.mcpProcessWiring.connectNonBlocking(), the same flag the pinned tengu_sdk_init_handshake reports as true for the emulated session"
      },
      "emulated": "no MCP servers configured, no --mcp-config, no --sdk-url => all counts 0, waits 0, deadline 2000, localOnly/willDeferMcp false, waitForDeferrable true, mcpNonBlocking true"
    }
  ],
