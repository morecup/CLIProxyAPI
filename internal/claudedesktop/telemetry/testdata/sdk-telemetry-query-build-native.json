  "contracts": [
    {
      "event": "tengu_query_before_attachments",
      "slice": "before_attachments",
      "gateway": "executable",
      "keys": [
        "messagesForQueryCount",
        "assistantMessagesCount",
        "toolResultsCount",
        "queryChainId",
        "queryDepth"
      ],
      "derivations": {
        "messagesForQueryCount": "Fe.length: internal message rows before the assistant turn that produced the tool calls",
        "assistantMessagesCount": "We.length: internal assistant rows of that turn (one per streamed content block)",
        "toolResultsCount": "jt.length before attachments: one internal user row per tool_result",
        "queryChainId": "queryChainIdForAnalytics of the query",
        "queryDepth": "queryTracking.depth (0 main, +1 per subagent level)"
      },
      "condition": "every loop iteration whose assistant turn ended with tool_use blocks, after the tools ran and before attachment generation; skipped for the loop/wakeup early return",
      "position": "query loop, after tool execution; precedes tengu_attachments, tengu_query_after_attachments, the next request build (tengu_tool_search_mode_decision, tengu_api_before_normalize) and tengu_api_query"
    },
    {
      "event": "tengu_attachments",
      "slice": "attachments_generator",
      "gateway": "executable",
      "keys": [
        "attachment_types"
      ],
      "derivations": {
        "attachment_types": "l.map(c=>c.type): types of the attachments y0s produced for this iteration, in production order (not deduplicated)"
      },
      "condition": "ltr(): only when y0s returned at least one attachment (l.length>0)",
      "position": "between tengu_query_before_attachments and tengu_query_after_attachments; tengu_deferred_tools_pool_change (XHr, inside y0s) precedes it when the deferred_tools_delta attachment is produced"
    },
    {
      "event": "tengu_attachment_compute_duration",
      "slice": "compute_duration",
      "gateway": "boundary",
      "keys": [
        "label",
        "duration_ms",
        "attachment_size_bytes",
        "attachment_count"
      ],
      "failure_keys": [
        "label",
        "duration_ms",
        "error"
      ],
      "derivations": {
        "label": "X(generator label passed to fi())",
        "duration_ms": "Date.now() delta around the generator",
        "attachment_size_bytes": "sum of JSON.stringify(attachment).length over non-null results",
        "attachment_count": "r.length (including null slots)",
        "error": "true on the generator throwing"
      },
      "condition": "per generator label inside y0s, sampled with Math.random()<0.05 on both success and failure",
      "position": "inside y0s, before tengu_attachments",
      "boundary_reason": "random 5% sampling over the native generator label set (ide_selection, diagnostics, token_usage, ...) that the gateway does not run; the gateway only produces deferred_tools_delta and does not time a native generator"
    },
    {
      "event": "tengu_query_after_attachments",
      "slice": "after_attachments",
      "gateway": "executable",
      "keys": [
        "totalToolResultsCount",
        "fileChangeAttachmentCount",
        "queryChainId",
        "queryDepth"
      ],
      "derivations": {
        "totalToolResultsCount": "jt.length after attachments: tool_result rows plus attachment rows appended this iteration",
        "fileChangeAttachmentCount": "Qt(jt, row.type===\"attachment\"&&row.attachment.type===\"edited_text_file\")",
        "queryChainId": "same as before_attachments",
        "queryDepth": "same as before_attachments"
      },
      "condition": "every loop iteration that emitted tengu_query_before_attachments (unconditional after attachments)",
      "position": "after tengu_attachments; before max_turns check and the recursive next-turn request build"
    },
    {
      "event": "tengu_api_before_normalize",
      "slice": "before_normalize",
      "gateway": "executable",
      "keys": [
        "preNormalizedMessageCount"
      ],
      "derivations": {
        "preNormalizedMessageCount": "e.length: internal message rows handed to the request build ([...Fe,...We,...jt] on continuation turns) before normalization merges them into API messages"
      },
      "condition": "every API request build (first turn and continuation turns), after the tool schema build",
      "position": "request assembly: after the tool-search decision (j1e: tengu_tool_search_mode_decision) and tool schema build, before message normalization and tengu_api_query"
    },
    {
      "event": "tengu_context_size",
      "slice": "context_size",
      "gateway": "boundary",
      "keys": [
        "git_status_size",
        "claude_md_size",
        "has_user_email",
        "total_context_size",
        "project_file_count_rounded",
        "mcp_tools_count",
        "mcp_servers_count",
        "mcp_tools_tokens",
        "non_mcp_tools_count",
        "non_mcp_tools_tokens"
      ],
      "condition": "startup context measurement after MCP tools, tool pool, CLAUDE.md/user context and git status resolve (Promise.all), with a 1s project file count scan",
      "boundary_reason": "requires the native startup scan (git status length, CLAUDE.md length, project file count via zqr with AbortSignal.timeout(1000), tokenizer estimates Lc over tool schemas) that the gateway does not perform"
    },
    {
      "event": "tengu_client_data_cache_key",
      "slice": "client_data_cache_key",
      "gateway": "boundary",
      "keys": [
        "slot_hit",
        "slot_changed",
        "legacy_fallback",
        "slot_stale"
      ],
      "condition": "bootstrap cache persistence (module _395.js): fired while deciding whether the client_data cache slot for the account/org/entrypoint/model key changed before writing the config cache",
      "boundary_reason": "the gateway keeps no bootstrap client_data disk cache slots (clientDataCacheSlots), so slot_hit/slot_changed/slot_stale have no owned state"
    },
    {
      "event": "tengu_gzip_request_body_skipped",
      "slice": "gzip_skipped",
      "gateway": "boundary",
      "keys": [
        "rollout",
        "reason",
        "requestBodyChars"
      ],
      "condition": "wFo(e,t): if(e!==\"ccr_worker\")return; once per skip reason per process (ccrWorkerSkipReasonsLogged)",
      "boundary_reason": "the gateway has no gzip request-body path; the native skip reasons come from the gzip rollout state machine (El().gzipRequestBody) it does not run"
    },
    {
      "event": "tengu_cache_eviction_hint",
      "slices": [
        "cache_eviction_subagent",
        "cache_eviction_session_end"
      ],
      "gateway": "boundary",
      "keys": [
        "scope",
        "last_request_id"
      ],
      "condition": "subagent_end: after tengu_agent_tool_completed when the subagent's last requestId exists (let z=h.requestId;if(z)...); session_end: at process shutdown when WKe() returns a last request id; conversation_clear (module _403.js) on /clear",
      "boundary_reason": "no eviction moment is owned here: the gateway's subagent completion is the S2 tool-use lane's ToolExecuted hook (would need the child's last request id), and the gateway has no process session_end or /clear"
    },
    {
      "event": "tengu_heron_brook_applied",
      "slice": "heron_brook",
      "gateway": "boundary",
      "keys": [
        "len",
        "fromClientData"
      ],
      "condition": "system prompt assembly xUs(model): client_data tengu_heron_brook non-empty (fromClientData true) else feature tengu_heron_brook non-empty else vqt(model) selects the built-in section sqr (fromClientData false); otherwise no event",
      "boundary_reason": "whether the emulated Desktop system prompt includes the sqr section (vqt model gate, feature and client_data values) is not established for the owned prompt"
    },
    {
      "event": "tengu_fork_agent_query",
      "slice": "fork_agent_query",
      "gateway": "boundary",
      "keys": [
        "forkLabel",
        "querySource",
        "durationMs",
        "messageCount",
        "inputTokens",
        "outputTokens",
        "cacheReadInputTokens",
        "cacheCreationInputTokens",
        "serviceTier",
        "cacheCreationEphemeral1hTokens",
        "cacheCreationEphemeral5mTokens",
        "cacheHitRate",
        "queryChainId",
        "queryDepth"
      ],
      "condition": "fJo() after a forked-agent query completes; queryChainId/queryDepth only when queryTracking is set",
      "boundary_reason": "the owned runtime never runs forked-agent queries"
    }
  ],
