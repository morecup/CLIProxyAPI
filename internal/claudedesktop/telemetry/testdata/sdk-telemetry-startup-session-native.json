  "emulated_session": {
    "tengu_concurrent_sessions": {
      "metadata_when_two_live": {
        "num_sessions": 2
      },
      "condition": "num_sessions = this process + every other live Claude Code process of the OS user (GL counts <pid>.json registry records incl. process.pid); emitted only when >= 2. Gateway: one telemetry Manager = one emulated SDK process; count = enabled, not shut down Managers in the package registry (incl. the counting one)."
    },
    "tengu_timer": {
      "metadata": {
        "event": "startup",
        "durationMs": "<Manager uptime ms at emission>",
        "mcpNonBlocking": true,
        "mcpClientCount": 0,
        "resumed": false
      },
      "condition": "unconditional at runHeadless entry; durationMs = process uptime (Manager startedAt baseline, same as handshake uptime_ms), mcpNonBlocking = wa() (handshake pins true), mcpClientCount = configuredMcpServerCount (0: no MCP servers in the emulated environment, tengu_init mcpClientCount 0), resumed = !!(resume||continue) (false: each Manager starts a fresh application session)"
    }
  },
  "boundary": {
    "tengu_cli_flags": "boundary: flags = hs(commander options, source===\"cli\") over the Desktop argv. Beyond the constant prefix (inputFormat, outputFormat, verbose) and the CCD constants (model, permissionPromptTool, permissionMode, settingSources, includePartialMessages, settings, replay-user-messages extraArg), the argv carries per-conversation flags the gateway cannot observe at the emulated spawn: effort (i.effort, only visible later per request in output_config), allowedTools/allowDangerouslySkipPermissions (Desktop conversation/bypass state), thinking-display (GrowthBook snapshot + CLI capability), debugFile (lq()), managedSettings, resume/sessionId/forkSession, mcp-config/strict-mcp-config, add-dir. Captured samples show flag_count 7 and 15 with different flag sets.",
    "tengu_timer_plugins_init": "boundary: Ri() times Ti(t) (plugin initialization) on the else branch of the action-handler statement; the gateway performs no plugin initialization to time",
    "tengu_session_start": "boundary: Xs subscribes to session-id changes (qs) and logs only when the id changes after startup with source R(i); the emulated process keeps one application session id",
    "tengu_worker_permission_mode_restore": "boundary: th(m.messages,r,t) is called only from fN, the print lane's prior-session hydration (r.continue branch after Hp() loaded the prior conversation); Cu() = {source:\"none\",trustedMode:undefined,recordedMode:\"absent\"}, Mu() fills trusted_mode from the live toolPermissionContext.mode (setAppState), target_mode = trusted_mode when source is \"none\", had_external/had_internal constant false, guard_enabled = Di() = GrowthBook flag tengu_tranquil_fern (default true, memoized). The gateway starts each Manager with a fresh application session (no --continue/--resume hydration) and its feature store/bundle carries no tengu_tranquil_fern value, so neither the moment nor guard_enabled is derivable.",
    "tengu_headless_latency": "boundary: 5% per-process sample (_Zn=Math.random()<0.05) of headless profiler checkpoint spans (streaming_setup_ms, stdin_wait_ms, time_to_query_start_ms, ...) the gateway does not measure",
    "tengu_uds_startup_bind": "boundary: durationMs/bound come from a real cross-session inbox bind (startCrossSessionInbox)",
    "tengu_startup_perf": "boundary: 0.5% random sample or CLAUDE_CODE_PROFILE_STARTUP of measured startup checkpoint spans",
    "tengu_event_loop_stall": "boundary: periodic stall detector samples of the native event loop",
    "tengu_ripgrep_availability": "boundary: first native ripgrep invocation (testOnFirstUse)",
    "tengu_retention_sweep": "boundary: real transcript/session-file storage sweep counters",
    "tengu_push_reachability": "boundary: has_active_channel/platform_count come from the notification preferences response (r.prefs.push_reachability) which the gateway startup roles do not fetch"
  }
}
