  "events": {
    "tengu_bridge_repl_started": {
      "module": "B:/~BUN/root/_448.js",
      "slice": "bridge_started",
      "keys": [
        {
          "key": "has_initial_messages",
          "derivation": "!!(E&&E.length>0)",
          "conditional": false
        },
        {
          "key": "v2",
          "derivation": "!0",
          "conditional": false
        },
        {
          "key": "expires_in_s",
          "derivation": "kr.expires_in",
          "conditional": false
        },
        {
          "key": "inProtectedNamespace",
          "derivation": "ax()",
          "conditional": false
        },
        {
          "spread": "MSr()",
          "conditional": true
        }
      ],
      "condition": "once per bridge session, inline in the bridge setup right after the teardown closure (E7e) is defined and before ce(\"bridge_connect\"); E = initial history rows handed to the bridge, kr = the minted bridge credential response (expires_in)",
      "order": "after the bridge credential mint, before tengu_bridge_repl_ws_connected, tengu_bridge_placeholder_used_session and tengu_bridge_repl_teardown of the same session; independent of tengu_init (query lifecycle)",
      "constants": {
        "v2": true,
        "inProtectedNamespace": "ax() = _837.js le() => false on every host",
        "spread_MSr": "ISr() = _837.js Ne() => {namespace: undefined, cluster: undefined} so MSr() contributes no keys"
      },
      "executed_cases": [
        {
          "label": "fresh_session",
          "initial_messages": 0,
          "expires_in": 3600,
          "event": {
            "name": "tengu_bridge_repl_started",
            "metadata": {
              "has_initial_messages": false,
              "v2": true,
              "expires_in_s": 3600,
              "inProtectedNamespace": false
            }
          }
        },
        {
          "label": "resumed_history",
          "initial_messages": 12,
          "expires_in": 900,
          "event": {
            "name": "tengu_bridge_repl_started",
            "metadata": {
              "has_initial_messages": true,
              "v2": true,
              "expires_in_s": 900,
              "inProtectedNamespace": false
            }
          }
        },
        {
          "label": "undefined_history",
          "initial_messages": null,
          "expires_in": 3600,
          "event": {
            "name": "tengu_bridge_repl_started",
            "metadata": {
              "has_initial_messages": false,
              "v2": true,
              "expires_in_s": 3600,
              "inProtectedNamespace": false
            }
          }
        }
      ]
    },
    "tengu_bridge_repl_ws_connected": {
      "module": "B:/~BUN/root/_448.js",
      "slice": "bridge_ws_connected",
      "keys": [
        {
          "key": "v2",
          "derivation": "!0",
          "conditional": false
        },
        {
          "key": "cause",
          "derivation": "X(b_)",
          "conditional": false
        },
        {
          "key": "remint_attempts",
          "derivation": "Mv",
          "conditional": true,
          "condition": "Mv>0"
        }
      ],
      "condition": "v2 transport onConnect callback (zt.setOnConnect), not while torn down (qs); cause b_ = the connect cause label, remint_attempts only when Mv > 0",
      "order": "after tengu_bridge_repl_started; before tengu_bridge_repl_ws_closed",
      "executed_cases": [
        {
          "label": "initial",
          "remint_attempts": 0,
          "event": {
            "name": "tengu_bridge_repl_ws_connected",
            "metadata": {
              "v2": true,
