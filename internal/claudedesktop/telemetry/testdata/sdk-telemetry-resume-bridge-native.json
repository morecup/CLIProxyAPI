            "metadata": {
              "v2": true,
              "cause": "initial",
              "remint_attempts": 2
            }
          }
        }
      ]
    },
    "tengu_bridge_repl_ws_closed": {
      "module": "B:/~BUN/root/_448.js",
      "slice": "bridge_ws_closed",
      "keys": [
        {
          "key": "code",
