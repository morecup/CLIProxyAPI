  "cli_flags": {
    "builder": "hs(options, source): commander option attribute names whose getOptionValueSource(name) === \"cli\", sorted; flag_count = length, flags = join(\",\")",
    "argv_prefix_constant": [
      "--output-format stream-json",
      "--verbose",
      "--input-format stream-json"
    ],
    "ccd_always_present": [
      "--model (i.model || \"default\")",
      "--permission-prompt-tool stdio (canUseTool callback)",
      "--permission-mode <ie>",
      "--setting-sources=user,project,local",
      "--include-partial-messages",
      "--settings <json> (extraArgs.settings, always an object)"
    ],
    "session_dependent": [
      "--effort (i.effort)",
      "--agent (i.agent)",
      "--allow-dangerously-skip-permissions (R)",
      "--thinking-display / violin-bow extraArgs (buildBaseExtraArgs over snapshot + CLI capability)",
      "--managed-settings (t.ou(...))",
      "--resume=<id> / --session-id=<id> / --fork-session / --resume-session-at (new vs resumed conversation)",
      "--mcp-config / --strict-mcp-config (connectors)",
      "--add-dir (additional directories)",
      "--fallback-model",
      "--betas",
      "--debug-file (lq() when no custom spawn)",
      "--max-turns / --max-budget-usd / --task-budget",
      "systemPrompt/hooks are not argv flags"
    ],
    "verdict": "boundary: flag_count/flags depend on per-session Desktop state (effort, agent, skip-permissions, thinking-display, resume vs session-id, connectors, add-dir, managed settings, debug-file); only the argv prefix and the CCD constants are pinned"
  },
  "concurrent_sessions": {
    "counter": "Cd(a) = GL(e): lists the per-user session registry directory (wn()), counts <pid>.json records for process.pid and every live pid (oC), sweeping dead records only when isRegistrySweepPermitted()",
    "scope": "machine-wide: every live Claude Code process of the OS user regardless of account, entrypoint or Desktop conversation",
    "condition": "emitted once per process start when num_sessions >= 2",
    "verdict": "boundary: the gateway has no per-machine process registry (its SDK hosts are per-account turn executors, not Desktop conversations); a gateway-side count would be a lower bound, not the native value"
  },
