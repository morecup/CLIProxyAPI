      ],
      "members": [
        {
          "spread": "r",
          "conditional": true
        },
        {
          "key": "feature_name",
          "derivation": "a(e)",
          "conditional": false
        },
        {
          "key": "error_code",
          "derivation": "u",
          "conditional": false
        }
      ]
    },
    "resume_print": {
