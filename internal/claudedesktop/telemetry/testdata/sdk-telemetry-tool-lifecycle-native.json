    "session_resumed_print_success": {
      "event": "tengu_session_resumed",
      "module": "B:/~BUN/root/chunk-zhnz59d4.js",
      "slice": "resume_lane",
      "keys": [
        "entrypoint",
        "success",
        "interruption_kind",
        "resume_duration_ms"
      ],
      "members": [
        {
          "key": "entrypoint",
          "derivation": "rt(\"print\")",
          "conditional": false
        },
        {
          "key": "success",
          "derivation": "!0",
          "conditional": false
        },
        {
          "key": "interruption_kind",
