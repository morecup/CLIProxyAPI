        "scope",
        "last_request_id"
      ],
      "members": [
        {
          "key": "scope",
          "derivation": "de(\"session_end\")",
          "conditional": false
        },
        {
          "key": "last_request_id",
          "derivation": "yt(a)",
          "conditional": false
        }
      ]
    },
    "feature_bad": {
      "event": "tengu_feature_bad",
