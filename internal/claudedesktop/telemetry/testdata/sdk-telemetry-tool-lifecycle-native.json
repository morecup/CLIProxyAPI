  "events": {
    "tool_use_progress": {
      "event": "tengu_tool_use_progress",
      "module": "B:/~BUN/root/_448.js",
      "slice": "tool_use_progress",
      "keys": [
        "messageID",
        "toolName",
        "isMcp",
        "queryChainId",
        "queryDepth",
        "mcpServerType",
        "mcpServerBaseUrl",
        "requestId",
        "...Aw(e.name,u)",
        "...e.mcpInfo?.pluginTelemetry"
      ],
      "members": [
        {
          "key": "messageID",
          "derivation": "yt(i)",
          "conditional": false
        },
        {
          "key": "toolName",
          "derivation": "fr(e.name)",
          "conditional": false
        },
        {
          "key": "isMcp",
          "derivation": "e.isMcp??!1",
          "conditional": false
        },
        {
          "key": "queryChainId",
          "derivation": "yt(r.queryTracking?.chainId)",
          "conditional": false
        },
        {
          "key": "queryDepth",
          "derivation": "r.queryTracking?.depth",
          "conditional": false
        },
        {
          "key": "mcpServerType",
          "derivation": "X(l)",
          "conditional": true,
          "condition": "l"
        },
        {
          "key": "mcpServerBaseUrl",
          "derivation": "Gy(c)",
          "conditional": true,
          "condition": "c"
        },
        {
          "key": "requestId",
          "derivation": "yt(a)",
          "conditional": true,
          "condition": "a"
        },
        {
          "spread": "Aw(e.name,u)",
          "conditional": true
        },
        {
          "spread": "e.mcpInfo?.pluginTelemetry",
          "conditional": true
        }
      ]
    },
    "cache_eviction_hint_subagent_end": {
      "event": "tengu_cache_eviction_hint",
      "module": "B:/~BUN/root/_448.js",
      "slice": "agent_finalize",
      "keys": [
        "scope",
        "last_request_id"
      ],
      "members": [
        {
          "key": "scope",
          "derivation": "de(\"subagent_end\")",
          "conditional": false
        },
        {
          "key": "last_request_id",
          "derivation": "yt(z)",
          "conditional": false
        }
      ]
    },
    "cache_eviction_hint_session_end": {
      "event": "tengu_cache_eviction_hint",
      "module": "B:/~BUN/root/_448.js",
