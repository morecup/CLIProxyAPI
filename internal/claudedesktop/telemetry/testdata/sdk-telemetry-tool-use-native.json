  "emission": {
    "tool_use_can_use_tool_allowed": "fires once the permission result behavior is allow (the deny/ask branch returned tengu_tool_use_can_use_tool_rejected before it); precedes call; keys messageID/toolName/queryChainId/queryDepth then MCP dimensions, requestId when defined, Aw(name, mcpNameLoggable) (empty for non-MCP tools), plugin telemetry",
    "tool_use_progress": "pOs: one event per progress item the tool yields whose data.type !== \"tool_heartbeat\", during call, before tengu_tool_use_success; TaskOutput yields exactly one waiting_for_task progress item in block mode before waiting",
    "tool_use_success": "after call resolved: PUr(name,input,messageID) file-activity, ce(f) => tengu_feature_ok, then D(\"tengu_tool_use_success\") before the OTel tool_result span and before the tool_result message is built; durationMs = Date.now()-U (call wall clock), preToolHookDurationMs/permissionDurationMs = hook and permission phases, rss/heapUsed/external deltas = process.memoryUsage() after minus before, toolResultSizeBytes = content string length or JSON.stringify(content).length of mapToolResultToToolResultBlockParam(data).content, toolResultAttachmentBytes only when newMessages carry image/document blocks, toolInputSizeBytes = JSON.stringify(input).length",
    "feature_ok": "ce(f) on the success path (same call as tengu_tool_use_success)",
    "feature_sad": "te(f,\"tool_validate_input_rejected\") on validateInput rejection; te(f,\"tool_input_validation_failed\") on schema/JSON failure; te(f,BUr(err).code) for expected call errors",
    "feature_bad": "J(f,BUr(err).code) for unexpected call errors (isSad false)",
